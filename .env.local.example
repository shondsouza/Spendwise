# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project:
# 1. Go to https://supabase.com
# 2. Select your project
# 3. Settings → API → Copy Project URL and anon key

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# App Configuration
# ============================================
# Update this if you deploy to a custom domain

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# IMPORTANT NOTES
# ============================================
# 1. Never commit this file (use .env.local instead)
# 2. The anon key is PUBLIC (safe to expose)
# 3. NEVER use the service_role key in frontend
# 4. Keep your database password PRIVATE in .env.local
# 5. Vercel: Add these vars in Project Settings

